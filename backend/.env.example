APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# The backend auto-tries pooler URLs if the direct db.* host fails.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=

# n8n integration
N8N_RISK_ALERT_WEBHOOK_URL=your_n8n_production_webhook_url
N8N_TELEMETRY_WEBHOOK_URL=https://your-n8n.app.n8n.cloud/webhook/telemetry-risk-event
N8N_WEBHOOK_SECRET=
N8N_DEFAULT_ALERT_PHONE=+919XXXXXXXXX
PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.dev
